---
import Layout from '../layouts/Layout.astro';

const title = "About me";
const description = "Learn more about the developer behind the keyboard.";

const stack = [
  { name: "Astro",      icon: "https://cdn.simpleicons.org/astro" },
  { name: "React",      icon: "https://cdn.simpleicons.org/react" },
  { name: "TypeScript", icon: "https://cdn.simpleicons.org/typescript" },
  { name: "Tailwind",   icon: "https://cdn.simpleicons.org/tailwindcss" },
  { name: "Figma",      icon: "https://cdn.simpleicons.org/figma" },
  { name: "Webflow",    icon: "https://cdn.simpleicons.org/webflow" },
  { name: "Framer",     icon: "https://cdn.simpleicons.org/framer" },
];
---

<Layout {title} {description}>
  <section class="min-h-screen py-24 ">
  <div class="mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-start">

    <!-- Col 1: Text -->
    <div>
      <p class="text-xs uppercase tracking-widest text-base-content/50 mb-4">About</p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight leading-tight mb-10">
        What led me here
      </h1>

      <div class="space-y-6 text-base text-base-content/70 leading-relaxed max-w-prose">
        <p>
          I'm from Montevideo, Uruguay. I started in web development in 2008, building MySpace layouts — small experiments that turned into a real obsession with how the web works.
        </p>
        <p>
          By 2010, I built and maintained a network of Flash game websites that attracted significant traffic, using PHP, MySQL, and HTML. In 2012, I transitioned to WordPress and freelancing, collaborating remotely with a local studio to build websites and WooCommerce-powered e-commerce platforms.
        </p>
        <p>
          Along the way I built several web applications — many never launched, and I spent eight months on a game I never released. Those projects taught me more than the ones that shipped. How to iterate, how to cut, how to keep going anyway.
        </p>
        <p>
          Today I design and build websites and digital products, working with freelancers, studios and companies who care about getting the details right. My stack has evolved — React, Framer, Webflow, Astro, Figma — but the obsession is the same.
        </p>
      </div>

      <!-- Stack -->
      <div class="mt-12">
        <p class="text-xs uppercase tracking-widest text-base-content/50 mb-4">Stack</p>
        <div class="flex flex-wrap gap-2">
          {['Astro', 'TypeScript', 'HTML5', 'Tailwind', 'Webflow', 'Figma'].map(tech => (
            <span class="badge badge-outline rounded-full text-xs tracking-wide">{tech}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Col 2: Image -->
    <div class="w-full aspect-[3/4] rounded-xl overflow-hidden bg-base-200">
      <img
        src="/media/about/leandro.webp"
        alt="Leandro"
        class="w-full h-full object-cover"
      />
    </div>

  </div>
</section>
</Layout>