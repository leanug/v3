---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components'

import ServicesList from '../components/ui/Services/ServicesList.astro'; 
import FAQ from '../components/ui/FAQ.astro';

const title = "Services";
const description = "How I Can Help You Build & Grow";
---

<Layout {title} {description}>
  <section class="py-6 mt-8 md:mt-12">
    <div class="flex justify-between flex-wrap gap-6 items-center">
      <h1 class="font-medium text-2xl flex flex-col md:flex-row lg:items-center justify-start gap-1.5 leading-none tracking-tight">
        <span class="text-base-content/70">Need help</span>shipping a project?
      </h1>
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
        <a 
          href="mailto:leandroubilla@protonmail.com" 
          class="btn btn-neutral font-medium rounded-lg"
        >
          <Icon class="w-6 h-6" name="heroicons:inbox-solid" />
          Email me
        </a>
        <a 
          href="/about" 
          class="btn btn-outline font-medium rounded-lg"
        >
          <Icon class="w-6 h-6" name="heroicons:adjustments-horizontal-solid" />
          About me
        </a>
      </div>
    </div>
  </section>

  <ServicesList />

  <section class="mt-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-16">
      <div class="lg:sticky lg:top-24 lg:self-start w-full">
        <h1 class="text-2xl font-medium">Frequently Asked Questions</h1>
        <p class="text-base-content/70 mt-1 leading-relaxed">Everything you need to know before starting a project.</p>
      </div>
      <FAQ />
    </div>
  </section>
</Layout>