---
// ThemeToggle.astro
import { Icon } from 'astro-icon/components'
---

<div class="dropdown dropdown-end">
  <button tabindex="0" class="btn btn-ghost btn-md rounded-lg px-2 py-1">
    <span id="theme-dot-active" class="inline-flex items-center justify-center">
      <Icon id="icon-sun" class="w-4 h-4" name="heroicons:sun-solid" />      
      <Icon id="icon-moon" class="w-4 h-4" name="heroicons:moon-solid" />      
      <Icon id="icon-monitor" class="w-4 h-4" name="heroicons:computer-desktop-solid" />    </span>
      <Icon name="heroicons:chevron-down" />
  </button>

  <ul tabindex="0" class="dropdown-content menu bg-base-100/95 backdrop-blur-md border border-base-200 rounded-xl z-50 mt-2 w-52 p-2 shadow-lg gap-0.5">
    <li class="menu-title text-xs opacity-70 px-2 pb-1">Theme</li>
    <li>
      <button onclick="setTheme('cmyk')" class="flex items-center gap-3 rounded-lg px-2 py-2">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-base-200">
          <Icon id="icon-sun" class="w-4 h-4" name="heroicons:sun-solid" />      
        </span>
        <span class="text-sm font-medium">Light</span>
      </button>
    </li>
    <li>
      <button onclick="setTheme('dark')" class="flex items-center gap-3 rounded-lg px-2 py-2">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-base-200">
          <Icon id="icon-moon" class="w-4 h-4" name="heroicons:moon-solid" />
        </span>
        <span class="text-sm font-medium">Dark</span>
      </button>
    </li>
    <li>
      <button onclick="setTheme('system')" class="flex items-center gap-3 rounded-lg px-2 py-2">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-base-200">
          <Icon id="icon-monitor" class="w-4 h-4" name="heroicons:computer-desktop-solid" />
        </span>
        <span class="text-sm font-medium">System</span>
      </button>
    </li>
  </ul>
</div>

<script is:inline>
  // ⚙️ Global theme config — change here
  const THEMES = {
    light: 'cmyk',
    dark: 'black',
    lightFallback: 'lofi'
  }

  function updateIcon(theme) {
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
    const isSystem = theme === 'system'
    const isDark = isSystem ? prefersDark : theme === 'dark'

    document.getElementById('icon-sun').classList.toggle('hidden', isDark || isSystem)
    document.getElementById('icon-moon').classList.toggle('hidden', !isDark || isSystem)
    document.getElementById('icon-monitor').classList.toggle('hidden', !isSystem)
  }

  function applyTheme(theme) {
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
    const resolved = theme === 'system'
      ? (prefersDark ? THEMES.dark : THEMES.lightFallback)
      : theme === 'dark' ? THEMES.dark : THEMES.light

    document.documentElement.setAttribute('data-theme', resolved)
    localStorage.setItem('portfolio:theme', theme)
    updateIcon(theme)
  }

  function setTheme(theme) {
    applyTheme(theme)
    document.activeElement?.blur()
  }

  function init() {
    const stored = localStorage.getItem('portfolio:theme') || 'system'  // was 'theme'
    applyTheme(stored)
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if ((localStorage.getItem('portfolio:theme') || 'system') === 'system') applyTheme('system')
    })
  }

  init()
</script>