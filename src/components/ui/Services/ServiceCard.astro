---
// ServiceCard.astro
import { Icon } from 'astro-icon/components'

interface Props {
  index: string
  title: string
  description: string
  features: string[]
  platforms?: string[]
}

const { index, title, description, features, platforms } = Astro.props
---

<div class="bg-base-200/40 rounded-xl p-6 flex flex-col gap-6">

  <span class="text-xs tracking-[0.18em] text-base-content/40 font-medium">{index}</span>

  <div class="flex flex-col gap-3 flex-1">
    <h2 class="text-xl font-medium tracking-tight text-base-content">{title}</h2>
    <p class="text-sm text-base-content/70 leading-relaxed text-balance">{description}</p>
  </div>

  <ul class="flex flex-col gap-2.5">
    {features.map((f) => (
      <li class="flex items-center gap-2.5 text-sm text-base-content/70">
        <Icon name="heroicons:check" class="w-3.5 h-3.5 text-neutral shrink-0" />
        {f}
      </li>
    ))}
  </ul>

</div>