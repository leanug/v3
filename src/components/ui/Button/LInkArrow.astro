---
// components/ui/LinkArrow.astro
import { Icon } from 'astro-icon/components'

const { href, label, external = false } = Astro.props
---

<a
  href={href}
  class="inline-flex items-center gap-0.5 group text-base-content/70 hover:text-base-content transition-colors duration-200 relative"
  {...external && { target: '_blank', rel: 'noopener noreferrer' }}
>
  <span class="inline-flex items-center gap-1.5">
    {label}
    <Icon
      name={external ? 'lucide:move-up-right' : 'lucide:arrow-right'}
      class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1"
    />
  </span>
</a>