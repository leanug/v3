---
import { Image } from 'astro:assets';
---

<div class="text-md gap-3 flex items-center">
  <div class="relative w-10 h-10">
    <Image
      transition:name="profile-photo"
      src="/media/leandro.webp" 
      alt="Leandro Ubilla's logo" 
      class="w-10 h-10 rounded-lg border border-base-300" 
      width="56" 
      height="56"
      decoding="async"
      loading="lazy"
    />
    <span class="absolute -bottom-1.5 -right-1.5 w-3 h-3 bg-green-500 border border-white rounded-full"></span>
  </div>
  <span class="ml-1 font-medium text-lg">Leandro Ubilla</span>
</div>