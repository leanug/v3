---
// components/TestimonialCard.astro
const { quote, rating = 5, username, avatar, country, countryFlag } = Astro.props;
const initials = username.replace('@', '').slice(0, 2).toUpperCase();
---

<div class="card bg-base-200/30 rounded-xl p-6 flex flex-col gap-5">
  <div class="flex items-center gap-2">
    <div class="flex items-center gap-0.5">
      {[...Array(rating)].map(() => (
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-warning" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
      ))}
    </div>
    <span class="text-sm font-medium">{rating}.0</span>
  </div>

  <p class="text-base text-base-content/85 leading-relaxed flex-1 mb-3">"{quote}"</p>

  <div class="border-t border-base-content/10 pt-5 flex items-center gap-3">
    <div class="avatar">
      {avatar ? (
        <div class="w-10 rounded-full bg-base-300">
          <img src={avatar} alt={`${username} avatar`} />
        </div>
      ) : (
        <div class="w-10 h-10 rounded-full bg-primary/20 text-base-content text-sm flex items-center justify-center">
          {initials}
        </div>
      )}
    </div>
    <div class="space-y-0.5">
      <p class="text-sm">{username}</p>
      <div class="text-xs flex items-center gap-1">
        <span>{countryFlag}</span>
        <span class="text-base-content/60">{country}</span>
      </div>
    </div>
  </div>
</div>