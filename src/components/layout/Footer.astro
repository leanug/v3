---
import { Icon } from 'astro-icon/components'
---

<footer 
  class="flex flex-col sm:flex-row justify-between items-center flex-wrap w-full py-6 mt-12 xl:mt-14 gap-3 text-sm" 
  transition:persist
>
  <!-- Col 1 -->
  <p>© 2026 Leandro · <span class="text-base-content/70">Built with Astro & daisyUI</span></p>

  <!-- Col 2 -->
  <button 
    onclick="window.scrollTo({top:0,behavior:'smooth'})" 
    class="btn btn-ghost btn-sm uppercase text-base-content/70 rounded-lg gap-1.5"
  >
    Back to top <Icon name="heroicons:arrow-up" class="w-4 h-4" />
  </button>
</footer>