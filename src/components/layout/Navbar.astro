---
import Logo from "../ui/Logo.astro"
import ThemeToggle from '../../components/ui/ThemeToggle.astro'
import { Icon } from 'astro-icon/components'
---

<header class="mt-5 flex flex-row h-12 justify-between items-center gap-4 text-sm font-medium tracking-wide">
  
  <!-- Logo + mobile menu (left side) -->
  <div class="flex flex-row items-center gap-1.5">
    
    <!-- Mobile menu dropdown (hidden on desktop) -->
    <div class="dropdown lg:hidden">
      <button tabindex="0" aria-label="Open menu" class="btn btn-ghost btn-md rounded-md px-1.5 py-2 uppercase tracking-widest text-xs">
        <Icon name="heroicons:bars-3" class="w-5 h-5" />
      </button>

      <ul tabindex="-1" class="dropdown-content bg-base-100/95 backdrop-blur-md border border-base-200 rounded-xl z-50 mt-2 w-48 p-2 shadow-lg gap-0.5 flex flex-col">
        <li class="menu-title text-xs opacity-70 px-3 pb-1 uppercase tracking-widest">Pages</li>
        <li>
          <a href="/" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm hover:bg-base-200 transition-colors">Home</a>
        </li>
        <li>
          <a href="/about" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm hover:bg-base-200 transition-colors">About Me</a>
        </li>
        <li>
          <a href="/services" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm hover:bg-base-200 transition-colors">Services</a>
        </li>
        <li>
          <a href="https://linkedin.com/in/leandro-ubilla-gonzalez" target="_blank" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm hover:bg-base-200 transition-colors">LinkedIn</a>
        </li>
      </ul>
    </div>

    <a href="/"><Logo /></a>
  </div>

  <!-- Desktop nav + theme toggle (right side) -->
  <div class="flex flex-row items-center gap-4">
    <ul class="flex-row text-base-content/70 hidden lg:flex items-center">
      <li class="w-fit whitespace-nowrap">
        <a href="/about" class="btn btn-ghost font-medium">About</a>
      </li>
      <li class="w-fit whitespace-nowrap">
        <a href="/services" class="btn btn-ghost">Services</a>
      </li>
      <li class="w-fit whitespace-nowrap">
        <a href="https://linkedin.com/in/leandro-ubilla-gonzalez" target="_blank" class="btn btn-ghost font-medium">LinkedIn</a>
      </li>
    </ul>
    <ThemeToggle />
  </div>

</header>