---
import Logo from "../ui/Logo.astro"
import ThemeToggle from '../../components/ui/ThemeToggle.astro'
---

<header class="navbar bg-base-200 mt-1" transition:persist>
  <div class="navbar-start">
    <div class="dropdown">
      <div aria-label="Open menu" tabindex="0" role="button" class="btn btn-ghost px-2.5 lg:hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" /> </svg>
      </div>
      <ul
        tabindex="-1"
        class="menu menu-sm dropdown-content bg-base-100 z-1 mt-3 w-52 p-2 shadow">
        <li><a href="/about" aria-label="About me">About</a></li>
        <li><a href="/process" aria-label="Process">Process</a></li>
        <li><a href="/services" aria-label="Services">Services</a></li>
        <li><a href="/faq" aria-label="FAQ">FAQ</a></li>
        <li><a href="/work" aria-label="All work">All work</a></li>
        <li><a href="https://scriptingpixels.com" target="_blank"  aria-label="My blog">Blog</a></li>
      </ul>
    </div>
    <a href="/">
      <Logo />
    </a>
    <ul class="menu menu-horizontal px-1 ml-3">
      <li><a class="font-medium rounded-full" href="/about" aria-label="About me">About</a></li>
      <li><a class="font-medium rounded-full" href="/process" aria-label="Process">Process</a></li>
      <li><a class="font-medium rounded-full" href="/services" aria-label="Services">Services</a></li>
      <li><a class="font-medium rounded-full" href="/faq" aria-label="FAQ">FAQ</a></li>
      <li><a class="font-medium rounded-full" href="/work" aria-label="All work">All work</a></li>
      <li><a class="font-medium rounded-full" href="https://scriptingpixels.com" target="_blank"  aria-label="My blog">Blog</a></li>
    </ul>
  </div>
  
  <div class="navbar-end">
    <ThemeToggle />
    <a href="/contact" class="btn btn-neutral btn-sm ml-2">
      Contact Form
    </a>
  </div>
</header>